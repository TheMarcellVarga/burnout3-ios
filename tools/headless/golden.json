{
  "about": "Golden frames of the reference scenes (BO-54). Shots are taken by the scene drivers (to_*.sh, CAPTURE=1) at a flip offset from a log anchor; golden.py check/update/determinism. Reference PNGs live in golden_dir (outside git); this file holds only hashes and sizes.",
  "golden_dir": "runs/golden",
  "limits": {
    "same_backend": {
      "pixel_tol": 8,
      "max_channel_mae": 1.0,
      "max_bad_fraction": 0.01,
      "max_tile_bad_fraction": 0.25
    },
    "cross_backend": {
      "pixel_tol": 24,
      "max_channel_mae": 6.0,
      "max_bad_fraction": 0.1,
      "max_tile_bad_fraction": 0.6
    },
    "video": {
      "pixel_tol": 24,
      "max_channel_mae": 2.0,
      "max_bad_fraction": 0.02,
      "max_tile_bad_fraction": 0.25
    }
  },
  "xmv_place": {
    "frame": [
      640,
      464
    ],
    "x": 0,
    "y": 16,
    "w": 640,
    "h": 448
  },
  "backends": {
    "metal": {
      "status": "recorded on the Mac (M5), RECOMP_PB_BACKEND=metal"
    },
    "cpu": {
      "status": "recorded on the Mac, RECOMP_PB_BACKEND=cpu: the executor's reference (orakulum)"
    },
    "vulkan": {
      "status": "prepared, first on the Deck: the native Linux build (vk/run/burnout3) under deck_env.sh with DECK_NATIVE=1; the Vulkan backend writes back, so RECOMP_FB_DUMP_AT dumps it from guest memory like Metal"
    },
    "d3d11": {
      "status": "prepared, second on the Deck: the Windows build under Proton (deck_env.sh); RECOMP_D3D11_DUMP dumps the listed flips from the back buffer"
    },
    "xemu": {
      "status": "TODO: no xemu on the Mac by decision; see docs/running.md 'Golden frames' for the BLiNX 2 method and what a Deck/Linux capture needs (MCPX + flash BIOS, AppImage, F12 shots)"
    }
  },
