--- a/host/src/gpu_bridge.cpp
+++ b/host/src/gpu_bridge.cpp
@@ -1154,6 +1154,16 @@
     Bridge& s = *g_bridge;
     const u32 type = u32(call.prim & 7);
     if (type == 7) return;
+    // GS XY coordinates are exact multiples of 1/16 within a 16-bit range.
+    // Double products therefore compare the determinant exactly, including
+    // tiny valid triangles. A zero-area triangle writes neither colour nor Z;
+    // reject it before texture/target bookkeeping, as the software GS does.
+    if (type >= 3 && type <= 5 && call.count >= 3) {
+        const auto* v = call.vertices;
+        const double ax = double(v[1].x) - v[0].x, ay = double(v[1].y) - v[0].y;
+        const double bx = double(v[2].x) - v[0].x, by = double(v[2].y) - v[0].y;
+        if (ax * by == ay * bx) return;
+    }
     if (!s.primary && type < 3) return;                 // the shadow compares what it has always drawn
     const gs::Context& c = *call.context;
     ps2gpu::GsDrawState state;
