+++ b/host/include/ps2host/chain_copy.h
@@ -0,0 +1,28 @@
+#ifndef PS2HOST_CHAIN_COPY_H
+#define PS2HOST_CHAIN_COPY_H
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+#include <utility>
+#include <vector>
+namespace ps2host::detail {
+// Snapshot ownership lasts until the queued worker command has completed.
+// Keep initialized storage across pool reuse, so appending is one memcpy
+// rather than a general vector insertion (or zeroing followed by copying).
+struct DmaChainCopy {
+    std::vector<std::uint32_t> words = std::vector<std::uint32_t>(1u << 16);
+    std::vector<std::pair<std::uint32_t, std::uint32_t>> runs;
+    std::size_t used = 0;
+    void Reset() { used = 0; runs.clear(); }
+    void Append(const std::uint32_t* source, std::uint32_t count, std::uint32_t from) {
+        if (count > words.max_size() - used) throw std::length_error("DMA chain snapshot too large");
+        const std::size_t end = used + count;
+        if (end > words.size()) words.resize(std::max(end, words.size() * 2));
+        if (count) std::memcpy(words.data() + used, source, std::size_t(count) * sizeof(*source));
+        used = end;
+        runs.emplace_back(count, from);
+    }
+};
+}
+#endif
