             const u32 lines = std::min(gs::TheGs().ShownLines(), 448u);    // 224 in field mode
+            // iOS retains the last drawable. An unchanged target needs no
+            // new drawable and must not wait for another refresh: doing so
+            // feeds duplicates back into the GS queue and delays real frames.
+            static const bool skip_unchanged = std::getenv("PS2HOST_SKIP_UNCHANGED_PRESENT") != nullptr;
+            static std::uint64_t last_image = 0, last_drawn = ~std::uint64_t(0);
+            static u32 last_width = 0, last_lines = 0;
+            static u64 last_mutation = ~u64(0);
+            const auto drawn = found->second.drawn_serial;
+            if (skip_unchanged && image == last_image && drawn == last_drawn && g_mutations == last_mutation && w == last_width && lines == last_lines)
+                return;
+            last_mutation = g_mutations;
+            last_image = image; last_drawn = drawn; last_width = w; last_lines = lines;
             if (due_ns) display.PresentImageAt(image, layout, std::min(w, 640u * k), std::min(h, lines * k), due_ns);
             else display.PresentImage(image, layout, std::min(w, 640u * k), std::min(h, lines * k));
             return;
