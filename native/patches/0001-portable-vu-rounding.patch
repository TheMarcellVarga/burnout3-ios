--- /dev/null
+++ b/runtime/include/ps2rt/vu_rounding.h
@@ -0,0 +1,49 @@
+#ifndef PS2RT_VU_ROUNDING_H
+#define PS2RT_VU_ROUNDING_H
+
+#include "ps2rt/vu_math.h"
+#if PS2RT_VU_SSE
+#include <xmmintrin.h>
+#else
+#include <cfenv>
+#endif
+
+namespace lifted {
+
+// Shared by VU0 macro instructions and VU microprograms. The scalar arithmetic
+// cleans subnormal operands/results itself; the host scope supplies chop rounding
+// and restores the caller's entire floating-point environment afterwards.
+class ScopedVuRounding {
+public:
+    explicit ScopedVuRounding(bool enabled = true) : enabled_(enabled) {
+        if (!enabled_) return;
+#if PS2RT_VU_SSE
+        saved_ = _mm_getcsr();
+        _mm_setcsr((saved_ & ~0x6000u) | 0x6000u | 0x8000u | 0x0040u);
+#else
+        std::fegetenv(&saved_);
+        std::fesetround(FE_TOWARDZERO);
+#endif
+    }
+    ~ScopedVuRounding() {
+        if (!enabled_) return;
+#if PS2RT_VU_SSE
+        _mm_setcsr(saved_);
+#else
+        std::fesetenv(&saved_);
+#endif
+    }
+    ScopedVuRounding(const ScopedVuRounding&) = delete;
+    ScopedVuRounding& operator=(const ScopedVuRounding&) = delete;
+
+private:
+    bool enabled_;
+#if PS2RT_VU_SSE
+    unsigned saved_;
+#else
+    std::fenv_t saved_;
+#endif
+};
+
+}  // namespace lifted
+#endif
