+PS2RT_VU_INLINE uint32x4_t CleanNeon(uint32x4_t v) {
+    const auto magnitude = vandq_u32(v, vdupq_n_u32(0x7FFFFFFF));
+    const auto sign = veorq_u32(v, magnitude);
+    const auto clamped = vminq_u32(magnitude, vdupq_n_u32(kMax));
+    return vorrq_u32(sign, vandq_u32(clamped, vcgeq_u32(magnitude, vdupq_n_u32(0x00800000))));
+}
+PS2RT_VU_INLINE int32x4_t OrderNeon(uint32x4_t v) {
+    const auto magnitude = vreinterpretq_s32_u32(vandq_u32(v, vdupq_n_u32(0x7FFFFFFF)));
+    return vbslq_s32(vcltq_s32(vreinterpretq_s32_u32(v), vdupq_n_s32(0)), vnegq_s32(magnitude), magnitude);
+}
+template <int Op, int Known = 0>
+PS2RT_VU_INLINE uint32x4_t LanesNeon(uint32x4_t a, uint32x4_t b, uint32x4_t acc) {
+    if constexpr (Op == kMax_ || Op == kMini) {
+        const auto take_b = Op == kMax_ ? vcltq_s32(OrderNeon(a), OrderNeon(b))
+                                        : vcltq_s32(OrderNeon(b), OrderNeon(a));
+        return vbslq_u32(take_b, b, a);
+    }
+    if constexpr ((Known & 1) == 0) a = CleanNeon(a);
+    if constexpr ((Known & 2) == 0) b = CleanNeon(b);
+    const auto x = vreinterpretq_f32_u32(a), y = vreinterpretq_f32_u32(b);
+    if constexpr (Op == kAdd) return CleanNeon(vreinterpretq_u32_f32(vaddq_f32(x, y)));
+    else if constexpr (Op == kSub) return CleanNeon(vreinterpretq_u32_f32(vsubq_f32(x, y)));
+    else if constexpr (Op == kMul) return CleanNeon(vreinterpretq_u32_f32(vmulq_f32(x, y)));
+    else if constexpr (Op == kMadd || Op == kMsub) {
+        const auto product = vreinterpretq_f32_u32(CleanNeon(vreinterpretq_u32_f32(vmulq_f32(x, y))));
+        const auto total = vreinterpretq_f32_u32((Known & 4) ? acc : CleanNeon(acc));
+        return CleanNeon(vreinterpretq_u32_f32(Op == kMadd ? vaddq_f32(total, product) : vsubq_f32(total, product)));
+    }
+}
