set(GPU_DEPS "${CMAKE_CURRENT_SOURCE_DIR}/local/gpu-deps")
if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
    set(MVK_ROOT "${GPU_DEPS}/moltenvk-ios/MoltenVK/MoltenVK")
    set(MVK_SLICE "ios-arm64")
else()
    set(MVK_ROOT "${GPU_DEPS}/moltenvk-macos/MoltenVK/MoltenVK")
    set(MVK_SLICE "macos-arm64_x86_64")
endif()
set(MVK_LIBRARY "${MVK_ROOT}/static/MoltenVK.xcframework/${MVK_SLICE}/libMoltenVK.a")
set(GLSLANG "${CMAKE_CURRENT_SOURCE_DIR}/build/glslang/StandAlone/glslang")
if(NOT EXISTS "${MVK_LIBRARY}" OR NOT EXISTS "${GLSLANG}")
    message(FATAL_ERROR "GPU dependencies missing: run scripts/prepare_gpu.py")
endif()
set(PS2GPU_SHADER_DIR "${CMAKE_CURRENT_BINARY_DIR}/gpu_shaders")
file(MAKE_DIRECTORY "${PS2GPU_SHADER_DIR}")
set(PS2GPU_SHADER_HEADERS)
function(apple_shader NAME SOURCE)
    set(OUT "${PS2GPU_SHADER_DIR}/${NAME}.h")
    add_custom_command(OUTPUT "${OUT}"
        COMMAND "${GLSLANG}" -V --target-env vulkan1.3 ${ARGN} --vn "spirv_${NAME}"
            -o "${OUT}" "${ENGINE}/gpu/shaders/${SOURCE}"
        DEPENDS "${ENGINE}/gpu/shaders/${SOURCE}" "${ENGINE}/gpu/shaders/gs_address.glsl"
        VERBATIM)
    set(PS2GPU_SHADER_HEADERS ${PS2GPU_SHADER_HEADERS} "${OUT}" PARENT_SCOPE)
endfunction()
foreach(SHADER gs.vert gs.frag date.vert date.frag swizzle.comp decode.comp depth_load.frag patch.comp)
    string(REPLACE "." "_" NAME "${SHADER}")
    apple_shader("${NAME}" "${SHADER}")
endforeach()
apple_shader(gs_frag_single gs.frag -DSINGLE_OUTPUT)
apple_shader(gs_frag_blend gs.frag -DSHADER_BLEND)
apple_shader(gs_frag_local gs.frag -DSHADER_BLEND -DLOCAL_READ)
apple_shader(swizzle_image_comp swizzle.comp -DIMAGE)
apple_shader(swizzle_depth_comp swizzle.comp -DDEPTH_IMAGE)
add_library(ps2gpu_apple STATIC "${ENGINE}/gpu/src/gpu.cpp" "${ENGINE}/gpu/src/gs_renderer.cpp" ${PS2GPU_SHADER_HEADERS})
target_include_directories(ps2gpu_apple PUBLIC "${ENGINE}/gpu/include" PRIVATE
    "${CMAKE_CURRENT_SOURCE_DIR}/native/gpu" "${MVK_ROOT}/include" "${PS2GPU_SHADER_DIR}")
target_compile_definitions(ps2gpu_apple PRIVATE PS2GPU_MOLTENVK=1)
target_link_libraries(ps2gpu_apple PUBLIC "${MVK_LIBRARY}" "-framework Metal" "-framework QuartzCore"
    "-framework IOSurface" "-framework Foundation" "-framework CoreGraphics" "-lz")
# Reuse the upstream pixel checks on both Mac and device. A missing device is
# an explicit skip code, never a successful GPU check.
file(READ "${ENGINE}/gpu/tests/renderer_tests.cpp" GPU_TEST_SOURCE)
string(REPLACE "int main() {" "int RunGpuRendererTests() {" GPU_TEST_SOURCE "${GPU_TEST_SOURCE}")
string(REPLACE "(skipped)\\n\", error.c_str());\n        return 0;" "(skipped)\\n\", error.c_str());\n        return 77;" GPU_TEST_SOURCE "${GPU_TEST_SOURCE}")
string(REPLACE "int RunGpuRendererTests() {" "#include \"${CMAKE_CURRENT_SOURCE_DIR}/native/tests/gpu_mask_tests.inc\"\nint RunGpuRendererTests() {" GPU_TEST_SOURCE "${GPU_TEST_SOURCE}")
string(REPLACE "    if (g_failures) std::printf" "    g_failures += RunGpuMaskChecks(*renderer);\n    if (g_failures) std::printf" GPU_TEST_SOURCE "${GPU_TEST_SOURCE}")
set(PS2GPU_TEST_HARNESS "${CMAKE_CURRENT_BINARY_DIR}/generated/gpu_renderer_tests.cpp")
file(WRITE "${PS2GPU_TEST_HARNESS}" "${GPU_TEST_SOURCE}")
if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
    target_link_libraries(ps2gpu_apple PUBLIC "-framework UIKit")
else()
    target_link_libraries(ps2gpu_apple PUBLIC "-framework IOKit" "-framework AppKit")
    add_executable(apple_gpu_tests native/tests/gpu_tests_main.cpp "${PS2GPU_TEST_HARNESS}")
    target_link_libraries(apple_gpu_tests PRIVATE ps2gpu_apple)
    add_test(NAME apple_gpu_renderer COMMAND apple_gpu_tests)
endif()
